<?php
/**
 * @file
 * Hooks for the tienda_virtual module.
 */

/**
 * Implements hook_theme().
 */
function tienda_virtual_theme($existing, $type, $theme, $path): array {
  return [
    'tienda_catalog' => [
      'variables' => [
        'products'    => [],
        'keyword'     => '',
        'category_id' => '',
        'categories'  => [],
        'total'       => 0,
        'page'        => 1,
        'total_pages' => 1,
        'per_page'    => 12,
        'page_range'  => [],
      ],
    ],
    'tienda_search_advanced' => [
      'variables' => [
        'products'    => [],
        'keyword'     => '',
        'category_id' => '',
        'categories'  => [],
        'price_min'   => '',
        'price_max'   => '',
        'sort'        => 'title',
        'total'       => 0,
      ],
    ],
  ];
}
