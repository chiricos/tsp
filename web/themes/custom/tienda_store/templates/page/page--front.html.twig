{#
/**
 * @file
 * Homepage override - Commerce Kickstart style with hero carousel + product sections.
 *
 * Extends Belgrade's page template. Available variables: same as page.html.twig.
 * Custom variables added via tienda_store_preprocess_page():
 * - featured_products: rendered array of product teasers (new arrivals, 4 items).
 * - bestseller_products: rendered array of product teasers (oldest = repeat buyers, 4 items).
 * - catalog_url: URL to the full product catalog.
 */
#}

<div{{ attributes }}>
  {# Skip link #}
  <a href="#main-content" class="visually-hidden-focusable">{{ 'Skip to main content'|t }}</a>

  {# Top bar #}
  {% if page.top_bar %}
    {{ page.top_bar }}
  {% endif %}

  {# Header #}
  {% if page.header %}
    <header role="banner">
      <div class="container-xl">{{ page.header }}</div>
    </header>
  {% endif %}

  {# Navigation #}
  {% if page.navigation %}
    <nav role="navigation" aria-label="{{ 'Main navigation'|t }}">
      <div class="container-xl">{{ page.navigation }}</div>
    </nav>
  {% endif %}

  {# Messages #}
  {% if page_top %}{{ page_top }}{% endif %}

  {# Admin tabs #}
  {% if primary_local_tasks %}{{ primary_local_tasks }}{% endif %}
  {% if secondary_local_tasks %}{{ secondary_local_tasks }}{% endif %}
  {% if action_links %}{{ action_links }}{% endif %}

  {# ============================================================
     HERO CAROUSEL
     ============================================================ #}
  <div id="tsHeroCarousel" class="carousel slide carousel-fade ts-hero" data-bs-ride="carousel">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#tsHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#tsHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#tsHeroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
      {# Slide 1 #}
      <div class="carousel-item active" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
        <div class="d-flex align-items-center justify-content-center" style="min-height:460px;">
          <div class="container-xl text-white py-5">
            <div class="row align-items-center">
              <div class="col-md-6">
                <p class="text-uppercase fw-semibold mb-2 opacity-75" style="letter-spacing:.1em;">{{ 'Novedades literarias'|t }}</p>
                <h2 class="display-4 fw-bold mb-3">{{ 'Los mejores libros<br>a tu alcance'|t|raw }}</h2>
                <p class="lead mb-4 opacity-75">{{ 'Descubre nuestra selección de títulos en literatura, ciencia, arte y más. Envío gratuito en pedidos superiores a $50.'|t }}</p>
                <a href="{{ catalog_url }}" class="btn btn-light btn-lg px-4 me-2">{{ 'Explorar catálogo'|t }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      {# Slide 2 #}
      <div class="carousel-item" style="background: linear-gradient(135deg, #0f3460 0%, #533483 100%);">
        <div class="d-flex align-items-center justify-content-center" style="min-height:460px;">
          <div class="container-xl text-white py-5">
            <div class="row align-items-center">
              <div class="col-md-5 offset-md-7 text-md-end">
                <p class="text-uppercase fw-semibold mb-2 opacity-75" style="letter-spacing:.1em;">{{ 'Ofertas del mes'|t }}</p>
                <h2 class="display-4 fw-bold mb-3">{{ 'Grandes títulos,<br>mejores precios'|t|raw }}</h2>
                <p class="lead mb-4 opacity-75">{{ 'Best sellers, clásicos y ediciones especiales con descuentos exclusivos para ti.'|t }}</p>
                <a href="{{ catalog_url }}" class="btn btn-outline-light btn-lg px-4">{{ 'Ver ofertas'|t }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      {# Slide 3 #}
      <div class="carousel-item" style="background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);">
        <div class="d-flex align-items-center justify-content-center" style="min-height:460px;">
          <div class="container-xl text-white py-5">
            <div class="row align-items-center">
              <div class="col-md-6">
                <p class="text-uppercase fw-semibold mb-2 opacity-75" style="letter-spacing:.1em;">{{ 'Colección 2025'|t }}</p>
                <h2 class="display-4 fw-bold mb-3">{{ 'Lee, aprende<br>y transforma tu mundo'|t|raw }}</h2>
                <p class="lead mb-4 opacity-75">{{ 'Desde novelas apasionantes hasta manuales técnicos: encuentra el libro que estabas buscando.'|t }}</p>
                <a href="{{ catalog_url }}" class="btn btn-light btn-lg px-4">{{ 'Descubrir'|t }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#tsHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
      <span class="visually-hidden">{{ 'Previous'|t }}</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#tsHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
      <span class="visually-hidden">{{ 'Next'|t }}</span>
    </button>
  </div>
  {# / HERO CAROUSEL #}

  {# ============================================================
     MAIN CONTENT
     ============================================================ #}
  <main id="main-content" role="main">

    {# ── NEW PRODUCTS ── #}
    {% if featured_products %}
      <section class="ts-section bg-white">
        <div class="container-xl">
          <div class="d-flex align-items-baseline justify-content-between mb-4">
            <h2 class="ts-section-title">{{ 'Nuevos productos'|t }}</h2>
            <a href="{{ catalog_url }}" class="text-primary fw-semibold small">{{ 'Ver todos →'|t }}</a>
          </div>
          <div class="row row-cols-2 row-cols-md-4 g-4">
            {% for product in featured_products %}
              <div class="col">{{ product }}</div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {# ── PROMO BANNER ── #}
    <section class="ts-promo py-4" style="background: linear-gradient(90deg, #0f3460, #533483);">
      <div class="container-xl">
        <div class="row align-items-center text-white g-3">
          <div class="col-sm-4 text-center">
            <div class="d-flex align-items-center justify-content-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456z"/></svg>
              <span class="fw-semibold">{{ 'Envío gratis desde $50'|t }}</span>
            </div>
          </div>
          <div class="col-sm-4 text-center">
            <div class="d-flex align-items-center justify-content-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10h14V4h-3.5zM2 5h12v8H2V5z"/></svg>
              <span class="fw-semibold">{{ 'Pago 100% seguro'|t }}</span>
            </div>
          </div>
          <div class="col-sm-4 text-center">
            <div class="d-flex align-items-center justify-content-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z"/></svg>
              <span class="fw-semibold">{{ 'Garantía 30 días'|t }}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {# ── BEST SELLERS ── #}
    {% if bestseller_products %}
      <section class="ts-section bg-light">
        <div class="container-xl">
          <div class="d-flex align-items-baseline justify-content-between mb-4">
            <h2 class="ts-section-title">{{ 'Más vendidos'|t }}</h2>
            <a href="{{ catalog_url }}" class="text-primary fw-semibold small">{{ 'Ver todos →'|t }}</a>
          </div>
          <div class="row row-cols-2 row-cols-md-4 g-4">
            {% for product in bestseller_products %}
              <div class="col">{{ product }}</div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {# Blocks in the content region (admin tabs etc.) #}
    {% if page.content %}
      <div class="visually-hidden">{{ page.content }}</div>
    {% endif %}

  </main>
  {# / MAIN #}

  {% include directory ~ '/templates/page/_footer.html.twig' %}

  {% if page_bottom %}{{ page_bottom }}{% endif %}
</div>
