{#
/**
 * @file
 * Tienda Store — mini pager override with icons and centered styling.
 */
#}
{% import "@belgrade/macros.twig" as svg %}

{% if items.previous or items.next %}
  <nav class="ts-pager d-flex justify-content-center align-items-center gap-2 mt-5"
       role="navigation" aria-labelledby="{{ heading_id }}">
    <h4 id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</h4>

    {# ── Previous ── #}
    {% if items.previous %}
      <a href="{{ items.previous.href }}" class="ts-pager__btn"
         title="{{ 'Go to previous page'|t }}" rel="prev"
         {{ items.previous.attributes|without('href', 'title', 'rel') }}>
        {{ svg.getIcon('chevron-left', 18, 18) }}
        <span class="visually-hidden">{{ 'Previous page'|t }}</span>
      </a>
    {% else %}
      <span class="ts-pager__btn ts-pager__btn--disabled" aria-disabled="true">
        {{ svg.getIcon('chevron-left', 18, 18) }}
      </span>
    {% endif %}

    {# ── Current page ── #}
    {% if items.current %}
      <span class="ts-pager__current">
        {{ 'Page'|t }} {{ items.current }}
      </span>
    {% endif %}

    {# ── Next ── #}
    {% if items.next %}
      <a href="{{ items.next.href }}" class="ts-pager__btn"
         title="{{ 'Go to next page'|t }}" rel="next"
         {{ items.next.attributes|without('href', 'title', 'rel') }}>
        {{ svg.getIcon('chevron-right', 18, 18) }}
        <span class="visually-hidden">{{ 'Next page'|t }}</span>
      </a>
    {% else %}
      <span class="ts-pager__btn ts-pager__btn--disabled" aria-disabled="true">
        {{ svg.getIcon('chevron-right', 18, 18) }}
      </span>
    {% endif %}

  </nav>
{% endif %}
