{#
/**
 * @file
 *
 * Default product template.
 *
 * Available variables:
 * - attributes: HTML attributes for the wrapper.
 * - product: The rendered product fields.
 *   Use 'product' to print them all, or print a subset such as
 *   'product.title'. Use the following code to exclude the
 *   printing of a given field:
 *   @code
 *   {{ product|without('title') }}
 *   @endcode
 * - product_entity: The product entity.
 * - product_url: The product URL.
 *
 * @ingroup themeable
 */
#}

{%
  set classes = [
  'pb-4',
  'mb-5',
  'overflow-hidden'
]
%}

<article{{ attributes.addClass(classes) }}>
  <div class="row g-4 align-items-start">

    {# ── Columna izquierda: imagen ─────────────────────────────────────── #}
    <div class="col-md-5 text-center">
      {{- product.field_product_image -}}
      {{- product.variation_images -}}
      {{- product.images -}}
    </div>

    {# ── Columna derecha: info y acciones ─────────────────────────────── #}
    <div class="col-md-7">
      <div class="mb-2">
        {{- product.product_categories -}}
      </div>
      {{- product.title -}}
      {{- product.brand -}}
      <div class="fs-4">{{- product.variation_price -}}</div>
      <hr/>
      {% if product.special_categories|render is not empty %}
        <div class="mb-3">
          {{- product.special_categories -}}
        </div>
      {% endif %}
      {{- product|without('field_product_image', 'variation_images', 'images', 'variation_attributes', 'title', 'variation_price', 'product_categories', 'brand', 'special_categories') -}}
    </div>

  </div>
</article>
